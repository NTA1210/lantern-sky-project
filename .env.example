# Cấu hình triển khai Lantern Sky lên Internet
# Sao chép file này thành .env và thay đổi mật khẩu trước khi public.

# Tài khoản đăng nhập vào trang Control (/control)
LANTERN_CONTROL_USER=admin
LANTERN_CONTROL_PASSWORD=thay-mat-khau-manh-tai-day

# Bí mật ký session cookie (nên đặt chuỗi ngẫu nhiên dài khi chạy production)
# LANTERN_AUTH_SECRET=thay-chuoi-bi-mat-ngau-nhien-64-ky-tu

# Thời hạn phiên đăng nhập (giờ)
LANTERN_SESSION_HOURS=12

# Bắt buộc cookie Secure (auto = tự bật khi qua HTTPS / reverse proxy)
LANTERN_COOKIE_SECURE=auto

# Khi deploy server / VPS / Docker, thường bind 0.0.0.0 và tắt mở browser tự động
# LANTERN_HOST=0.0.0.0
# PORT=8000
# LANTERN_NO_BROWSER=1
# LANTERN_RELOAD=0

